# Copy to /etc/personal-site/cloud-monitor.env (mode 600, owner root:root).
# Do not commit a filled-in copy. One file per VM; change the device block.
#
# The agent POSTs CPU, memory, root disk, optional volumes, and uptime to:
#   https://monitor.example.com/api/monitor/remote/report
# CLOUD_MONITOR_SECRET must be at least 32 characters and must match the
# site's REMOTE_CLOUD_MONITOR_SECRET, or the per-slot REMOTE_CLOUD_N_* secret
# when this device has its own override (at most 8 cloud slots).
#
# The placeholder below is long enough for the agent to start and is not a
# real secret. Replace it before enabling the service.

CLOUD_MONITOR_ENDPOINT="https://monitor.example.com/api/monitor/remote/report"
CLOUD_MONITOR_SECRET="replace-with-at-least-32-character-secret"
CLOUD_MONITOR_INTERVAL="15"
CLOUD_MONITOR_TIMEOUT="10"

# Example VM A. 203.0.113.10 is an RFC 5737 documentation address.
CLOUD_DEVICE_ID="cloud-example-a"
CLOUD_DEVICE_NAME="Example cloud VM A"
CLOUD_DEVICE_REGION="example-region-a"
CLOUD_DEVICE_IP="203.0.113.10"

# Example VM B. Use a different device id on every machine.
# 203.0.113.20 is an RFC 5737 documentation address.
# CLOUD_DEVICE_ID=cloud-example-b
# CLOUD_DEVICE_NAME=Example cloud VM B
# CLOUD_DEVICE_REGION=example-region-b
# CLOUD_DEVICE_IP=203.0.113.20

# Optional extra mount points. The root filesystem is always reported.
# A path on the same filesystem as / is ignored. Leave unset on a normal VM.
# CLOUD_MONITOR_PATHS=/data,/mnt/backup
